+++ b/bench_forward.py
@@ -0,0 +1,50 @@
+"""Microbenchmark: isolate the UNet GPU forward time (no compositing / JPEG / IO).
+
+Tells us whether /infer_stream throughput is GPU-bound or CPU/composite-bound.
+Run standalone (loads its own model copy ~7GB VRAM):
+  SYNCTALK_DTYPE=fp32 python bench_forward.py
+  SYNCTALK_DTYPE=bf16 python bench_forward.py
+"""
+import os, sys, time
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import torch
+from unet_328 import Model
+
+DTYPE = os.getenv("SYNCTALK_DTYPE", "fp32").lower()
+AUTO = {"bf16": torch.bfloat16, "fp16": torch.float16}.get(DTYPE)
+BS = int(os.getenv("SYNCTALK_BATCH_SIZE", "32"))
+AVATAR = os.getenv("SYNCTALK_AVATAR", "aifc-avatar-5-3min_exp_6")
+device = torch.device("cuda")
+
+ckpt_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "checkpoint", AVATAR)
+ckpt = os.path.join(ckpt_dir, sorted(os.listdir(ckpt_dir), key=lambda x: int(x.split(".")[0]))[-1])
+net = Model(6, "ave").to(device)
+net.load_state_dict(torch.load(ckpt, map_location=device, weights_only=False))
+net.eval()
+
+imgs = torch.zeros(BS, 6, 320, 320, device=device)
+audio = torch.zeros(BS, 32, 16, 16, device=device)
+
+def fwd():
+    with torch.no_grad():
+        if AUTO is not None:
+            with torch.autocast("cuda", dtype=AUTO):
+                p = net(imgs, audio)
+            return p.float()
+        return net(imgs, audio)
+
+for _ in range(10):  # warmup
+    fwd()
+torch.cuda.synchronize()
+
+N = 100
+t0 = time.perf_counter()
+for _ in range(N):
+    fwd()
+torch.cuda.synchronize()
+dt = time.perf_counter() - t0
+
+per_batch_ms = dt / N * 1000
+fps = BS * N / dt
+print(f"dtype={DTYPE} batch={BS}: {per_batch_ms:.2f} ms/batch  ->  {fps:.0f} GPU-only fps "
+      f"({BS} frames/batch)")
