+# Phase 1 (OPTIMIZATION_PLAN.md): optional autocast precision for the UNet forward.
+#   SYNCTALK_DTYPE=bf16  -> bfloat16 autocast (faster, lower VRAM, stable on Hopper)
+#   SYNCTALK_DTYPE=fp16  -> float16 autocast
+#   SYNCTALK_DTYPE=fp32  -> unchanged (default)
+# Master weights stay fp32; autocast casts per-op. Output is cast back to fp32 in
+# _gpu_forward before the *255 uint8 conversion.
+_DTYPE_NAME     = os.getenv("SYNCTALK_DTYPE", "fp32").lower()
+_AUTOCAST_DTYPE = {
+    "bf16": torch.bfloat16, "bfloat16": torch.bfloat16,
+    "fp16": torch.float16,  "float16": torch.float16,
+}.get(_DTYPE_NAME)
+
+# Phase 0/1 (OPTIMIZATION_PLAN.md): per-stage profiling of /infer_stream.
+# SYNCTALK_PROFILE=1 -> log prep / gpu / composite / serialize timing per request.
+_PROFILE = os.getenv("SYNCTALK_PROFILE", "0") == "1"
+
+# Stage pipelining (OPTIMIZATION_PLAN.md 1.6): run prep/gpu/composite as concurrent
+# coroutines connected by bounded queues so stages overlap (throughput gated by the
+# slowest stage, not their sum). SYNCTALK_PIPELINE=0 falls back to the sequential path.
+_PIPELINE = os.getenv("SYNCTALK_PIPELINE", "1") == "1"
+
+# Output-space composite (OPTIMIZATION_PLAN.md lever #2): composite directly in the
+# 540x960 output space instead of copying+compositing the full 1920x1080 frame and then
+# downscaling it per frame. Precomputes the downscaled background + 328 border crop once
+# at load. ~SSIM 0.999 vs the full-res path (not byte-identical). SYNCTALK_FAST_COMPOSITE=1.
+_FAST_COMPOSITE = os.getenv("SYNCTALK_FAST_COMPOSITE", "0") == "1"
+
+# GPU JPEG encode (OPTIMIZATION_PLAN.md 1.9): encode frames with the H200's dedicated
+# nvJPEG hardware engine (torchvision, ~0.26 ms/f) instead of CPU cv2.imencode (~1.83 ms/f).
+# Output is standard JPEG so the frontend/transport is unchanged. SYNCTALK_GPU_JPEG=1.
+_GPU_JPEG = os.getenv("SYNCTALK_GPU_JPEG", "0") == "1"
+if _GPU_JPEG:
+    from torchvision.io import encode_jpeg as _tv_encode_jpeg
+
 device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
 
 # ── AudioEncoder ──────────────────────────────────────────────
@@ -72,6 +107,10 @@ print(f"Pre-loading {len_img+1} avatar images...")
 # img_meta[i]:    (full_img_np, h, w, xmin, ymin, ymax) for compositing
 img_tensors = {}
 img_meta    = {}
+# img_meta_fast[i]: (bg540, crop328, xo, yo, wo, ho) — precomputed output-space composite
+# inputs (only when _FAST_COMPOSITE). bg540 = src downscaled to 540x960 once; crop328 =
+# the 328 border crop; (xo,yo,wo,ho) = the face region in 540x960 output space.
+img_meta_fast = {}
 
 def _load_lms(i: int) -> np.ndarray:
     """Load landmarks for index i, falling back to nearest neighbour if missing."""
@@ -128,16 +167,37 @@ for i in range(1, len_img + 1):
     img_tensors[i] = torch.cat([t_real, t_mask], dim=0)
     img_meta[i]    = (img, h, w, xmin, ymin, ymax)
 
-print(f"Avatar data ready — SyncTalk server live (batch_size={BATCH_SIZE})")
+    if _FAST_COMPOSITE:
+        # Precompute output-space inputs once (matches _composite's square face region
+        # cols xmin:xmin+(ymax-ymin)). bg540 IS the non-face output (downscaled src).
+        sq = ymax - ymin
+        face_crop = img[ymin:ymax, xmin:xmin + sq]
+        crop328_f = cv2.resize(face_crop, (328, 328), interpolation=cv2.INTER_CUBIC)
+        bg540 = cv2.resize(img, (540, 960), interpolation=cv2.INTER_AREA)
+        sx, sy = 540 / img.shape[1], 960 / img.shape[0]
+        xo, yo = round(xmin * sx), round(ymin * sy)
+        wo = min(round(sq * sx), 540 - xo)
+        ho = min(round(sq * sy), 960 - yo)
+        img_meta_fast[i] = (bg540, crop328_f, xo, yo, wo, ho)
+
+print(f"Avatar data ready — SyncTalk server live (batch_size={BATCH_SIZE}, "
+      f"fast_composite={_FAST_COMPOSITE})")
 
 # ── GPU warmup: compile CUDA kernels before first real request ─
-print("Warming up GPU (pre-compiling CUDA kernels)...")
+print(f"Warming up GPU (pre-compiling CUDA kernels, dtype={_DTYPE_NAME})...")
 _w_stream = torch.cuda.Stream()
 with torch.cuda.stream(_w_stream):
     with torch.no_grad():
-        _w_imgs  = torch.zeros(1, 6, 320, 320, device=device)
-        _w_audio = torch.zeros(1, 32, 16, 16, device=device)
-        net(_w_imgs, _w_audio)
+        # Warm up both batch=1 and a full batch so the autocast/fp32 kernels for the
+        # real request shapes are compiled before the first turn (no cold stall).
+        for _bs in (1, BATCH_SIZE):
+            _w_imgs  = torch.zeros(_bs, 6, 320, 320, device=device)
+            _w_audio = torch.zeros(_bs, 32, 16, 16, device=device)
+            if _AUTOCAST_DTYPE is not None:
+                with torch.autocast("cuda", dtype=_AUTOCAST_DTYPE):
+                    net(_w_imgs, _w_audio)
+            else:
+                net(_w_imgs, _w_audio)
 _w_stream.synchronize()
 del _w_imgs, _w_audio, _w_stream
 print("GPU warmup done")
@@ -180,7 +240,12 @@ def _gpu_forward(imgs_cpu: torch.Tensor, audio_cpu: torch.Tensor) -> np.ndarray:
         imgs  = imgs_cpu.to(device, non_blocking=True)
         audio = audio_cpu.to(device, non_blocking=True)
         with torch.no_grad():
-            preds = net(imgs, audio)
+            if _AUTOCAST_DTYPE is not None:
+                with torch.autocast("cuda", dtype=_AUTOCAST_DTYPE):
+                    preds = net(imgs, audio)
+                preds = preds.float()  # CRITICAL: back to fp32 before the *255 uint8 cast
+            else:
