         preds_cpu = preds.cpu()
     stream.synchronize()
     return (preds_cpu.numpy().transpose(0, 2, 3, 1) * 255).astype(np.uint8)
@@ -256,10 +321,28 @@ def _prep_batch(audio_feats, frame_indices, batch_start: int, batch_end: int):
     return imgs_cpu, audio_cpu
 
 
-# ── CPU-only JPEG compositing ─────────────────────────────────
-def _composite(preds_np: np.ndarray, frame_idx_slice) -> list:
-    """Composite UNet predictions onto avatar images, return list of b64 JPEGs."""
-    result = []
+# ── JPEG encoding (CPU cv2 or GPU nvJPEG) ─────────────────────
+def _encode_b64(outs: list) -> list:
+    """Encode a list of BGR 540x960 frames to base64 JPEG strings.
+    GPU path (nvJPEG) when SYNCTALK_GPU_JPEG=1, else CPU cv2.imencode."""
+    if not _GPU_JPEG:
+        return [base64.b64encode(cv2.imencode(".jpg", o, [cv2.IMWRITE_JPEG_QUALITY, 82])[1]).decode()
+                for o in outs]
+    # nvJPEG wants RGB CHW uint8. Stack the batch, flip BGR->RGB, move once to GPU.
+    arr = np.ascontiguousarray(np.stack(outs)[..., ::-1])      # [N,H,W,3] RGB
+    t = torch.from_numpy(arr).to(device, non_blocking=True).permute(0, 3, 1, 2).contiguous()
+    try:
+        encoded = _tv_encode_jpeg([t[i] for i in range(t.shape[0])], quality=82)  # batched CUDA
+    except (TypeError, RuntimeError):
+        encoded = [_tv_encode_jpeg(t[i], quality=82) for i in range(t.shape[0])]
+    return [base64.b64encode(e.cpu().numpy().tobytes()).decode() for e in encoded]
+
+
+# ── Compositing (CPU) ─────────────────────────────────────────
+def _composite_full(preds_np: np.ndarray, frame_idx_slice) -> list:
+    """Composite predictions onto the full 1920x1080 frame, then downscale to 540x960.
+    Original path (SYNCTALK_FAST_COMPOSITE=0). Returns a list of b64 JPEGs."""
+    outs = []
     for j, fi_raw in enumerate(frame_idx_slice):
         fi = nearest_valid(fi_raw)
         src_img, h, w, xmin, ymin, ymax = img_meta[fi]
@@ -270,9 +353,28 @@ def _composite(preds_np: np.ndarray, frame_idx_slice) -> list:
         crop_r = cv2.resize(crop_r, (w, h), interpolation=cv2.INTER_CUBIC)
         out[ymin:ymax, xmin:xmin + (ymax - ymin)] = crop_r
         out = cv2.resize(out, (540, 960), interpolation=cv2.INTER_AREA)
-        _, buf = cv2.imencode(".jpg", out, [cv2.IMWRITE_JPEG_QUALITY, 82])
-        result.append(base64.b64encode(buf).decode())
-    return result
+        outs.append(out)
+    return _encode_b64(outs)
+
+
+def _composite_fast(preds_np: np.ndarray, frame_idx_slice) -> list:
+    """Composite directly in 540x960 output space using precomputed bg540/crop328
+    (SYNCTALK_FAST_COMPOSITE=1). Avoids the per-frame full-res copy + full-frame
+    downscale; only the small face region is resized. ~SSIM 0.999 vs _composite_full."""
+    outs = []
+    for j, fi_raw in enumerate(frame_idx_slice):
+        fi = nearest_valid(fi_raw)
+        bg540, crop328, xo, yo, wo, ho = img_meta_fast[fi]
+        crop_r = crop328.copy()
+        crop_r[4:324, 4:324] = preds_np[j]
+        face = cv2.resize(crop_r, (wo, ho), interpolation=cv2.INTER_AREA)
+        out = bg540.copy()
+        out[yo:yo + ho, xo:xo + wo] = face
+        outs.append(out)
+    return _encode_b64(outs)
+
+
+_composite = _composite_fast if _FAST_COMPOSITE else _composite_full
 
 
 # ── FrameAccumulator (Tier C) ─────────────────────────────────
@@ -365,8 +467,25 @@ async def infer_stream(req: InferRequest, request: Request):
 
     total_batches = (n_frames + BATCH_SIZE - 1) // BATCH_SIZE
 
-    async def generate():
+    def _log_profile(prof, gen_t0):
+        if not (_PROFILE and prof["frames"]):
+            return
+        n = prof["frames"]
+        wall = time.perf_counter() - gen_t0
+        print(
+            f"[profile] frames={n} wall={wall*1000:.0f}ms ({n/wall:.1f}fps) | "
+            f"per-frame ms: prep={prof['prep']/n*1000:.2f} gpu={prof['gpu']/n*1000:.2f} "
+            f"composite={prof['composite']/n*1000:.2f} serialize={prof['serialize']/n*1000:.2f} | "
+            f"stage sums ms: prep={prof['prep']*1000:.0f} gpu={prof['gpu']*1000:.0f} "
+            f"composite={prof['composite']*1000:.0f} serialize={prof['serialize']*1000:.0f}",
+            flush=True,
+        )
+
+    # ── Sequential path (SYNCTALK_PIPELINE=0) — original behaviour ──
+    async def generate_sequential():
         done_batches = 0
+        prof = {"prep": 0.0, "gpu": 0.0, "composite": 0.0, "serialize": 0.0, "frames": 0}
+        gen_t0 = time.perf_counter()
         for batch_start in range(0, n_frames, BATCH_SIZE):
             # Stop computing if the backend has cancelled this turn (barge-in /
             # interrupt). Checked before the GPU batch so we don't burn a forward
@@ -376,20 +495,125 @@ async def infer_stream(req: InferRequest, request: Request):
                       f"{done_batches}/{total_batches} batches", flush=True)
                 break
             batch_end = min(batch_start + BATCH_SIZE, n_frames)
+            _t = time.perf_counter()
             imgs_cpu, audio_cpu = await loop.run_in_executor(
                 _cpu_exec, _prep_batch,
                 audio_feats, frame_indices, batch_start, batch_end,
             )
+            prof["prep"] += time.perf_counter() - _t
+            _t = time.perf_counter()
             preds_np = await _accum.infer(imgs_cpu, audio_cpu)
+            prof["gpu"] += time.perf_counter() - _t
+            _t = time.perf_counter()
             frames   = await loop.run_in_executor(
                 _cpu_exec, _composite,
                 preds_np, frame_indices[batch_start:batch_end],
             )
+            prof["composite"] += time.perf_counter() - _t
             for frame in frames:
-                yield _json.dumps({"frame": frame}) + "\n"
+                _t = time.perf_counter()
+                line = _json.dumps({"frame": frame}) + "\n"
+                prof["serialize"] += time.perf_counter() - _t
+                yield line
+            prof["frames"] += len(frames)
             done_batches += 1
-
-    return StreamingResponse(generate(), media_type="application/x-ndjson")
+        _log_profile(prof, gen_t0)
+
+    # ── Pipelined path (SYNCTALK_PIPELINE=1, default) ──
+    # prep -> gpu -> composite run as three concurrent coroutines linked by bounded
+    # queues. Each stage is a single in-order consumer, so frame order is preserved;
+    # the bounded queues (maxsize=2) overlap stages while capping look-ahead memory.
+    async def generate_pipelined():
+        SENTINEL = object()
+        q_gpu  = asyncio.Queue(maxsize=2)
+        q_comp = asyncio.Queue(maxsize=2)
+        q_out  = asyncio.Queue(maxsize=2)
+        prof = {"prep": 0.0, "gpu": 0.0, "composite": 0.0, "serialize": 0.0, "frames": 0}
+        gen_t0 = time.perf_counter()
+        abort = asyncio.Event()
+
+        async def prep_stage():
+            for batch_start in range(0, n_frames, BATCH_SIZE):
+                if abort.is_set():
+                    break
+                batch_end = min(batch_start + BATCH_SIZE, n_frames)
+                _t = time.perf_counter()
+                imgs_cpu, audio_cpu = await loop.run_in_executor(
+                    _cpu_exec, _prep_batch,
+                    audio_feats, frame_indices, batch_start, batch_end,
+                )
+                prof["prep"] += time.perf_counter() - _t
+                await q_gpu.put((batch_start, batch_end, imgs_cpu, audio_cpu))
+            await q_gpu.put(SENTINEL)
+
+        async def gpu_stage():
+            done = 0
+            while True:
+                item = await q_gpu.get()
+                if item is SENTINEL:
+                    await q_comp.put(SENTINEL)
+                    break
+                # Abort-on-disconnect: bail before burning a GPU forward for frames
+                # nobody will receive (barge-in / interrupt).
+                if await request.is_disconnected():
+                    abort.set()
+                    print(f"[infer_stream] aborted on disconnect after "
+                          f"{done}/{total_batches} batches", flush=True)
+                    await q_comp.put(SENTINEL)
+                    break
+                batch_start, batch_end, imgs_cpu, audio_cpu = item
+                _t = time.perf_counter()
+                preds_np = await _accum.infer(imgs_cpu, audio_cpu)
+                prof["gpu"] += time.perf_counter() - _t
+                await q_comp.put((batch_start, batch_end, preds_np))
+                done += 1
+
+        async def comp_stage():
+            while True:
+                item = await q_comp.get()
+                if item is SENTINEL:
+                    await q_out.put(SENTINEL)
+                    break
+                batch_start, batch_end, preds_np = item
+                _t = time.perf_counter()
+                frames = await loop.run_in_executor(
+                    _cpu_exec, _composite,
+                    preds_np, frame_indices[batch_start:batch_end],
+                )
+                prof["composite"] += time.perf_counter() - _t
+                await q_out.put(frames)
+
+        tasks = [
+            asyncio.create_task(prep_stage()),
+            asyncio.create_task(gpu_stage()),
+            asyncio.create_task(comp_stage()),
+        ]
+        try:
+            while True:
+                frames = await q_out.get()
+                if frames is SENTINEL:
+                    break
+                for frame in frames:
+                    _t = time.perf_counter()
+                    line = _json.dumps({"frame": frame}) + "\n"
+                    prof["serialize"] += time.perf_counter() - _t
+                    yield line
+                prof["frames"] += len(frames)
+        finally:
+            # Cancel worker tasks synchronously FIRST so cleanup is guaranteed even when
+            # this generator is itself being cancelled (client disconnect / barge-in) —
+            # the cancel() calls run before the awaitable gather, which may be cut short.
+            abort.set()
+            for t in tasks:
+                t.cancel()
+            _log_profile(prof, gen_t0)
+            try:
+                await asyncio.gather(*tasks, return_exceptions=True)
+            except asyncio.CancelledError:
+                pass
+
+    _gen = generate_pipelined if _PIPELINE else generate_sequential
+    return StreamingResponse(_gen(), media_type="application/x-ndjson")
 
 
