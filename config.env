# Avatar system — default configuration
# All values here are non-secret and machine-independent.
# Override anything in .env (which is gitignored and holds secrets + local paths).

# --- Backend service ---
WS_BACKEND_HOST=0.0.0.0
WS_BACKEND_PORT=8080
FRONTEND_PORT=5173
VITE_IDLE_VIDEO_SRC=/idle.mp4
VITE_AVATAR_LABEL=aifc-avatar-5-3min_exp_6
MAX_HISTORY_TURNS=6

# --- Debug output (leave empty to disable) ---
DEBUG_RESPONSE_DIR=var/debug

# --- Soniox STT ---
SONIOX_STT_WS_URL=wss://stt-rt.soniox.com/transcribe-websocket
# v5 real-time model (v4 retires 2026-06-30). Better accuracy in noise/far-field,
# multilingual + accented speech, and alphanumerics (IINs, codes, emails) — all relevant
# to AIFC queries. Drop-in: same params as v4.
SONIOX_STT_MODEL=stt-rt-v5
SONIOX_STT_AUDIO_FORMAT=pcm_s16le
SONIOX_STT_SAMPLE_RATE=16000
SONIOX_STT_LANGUAGE_HINTS=en,ru,kk,zh
SONIOX_STT_LANGUAGE_HINTS_STRICT=true
SONIOX_STT_ENABLE_ENDPOINT_DETECTION=true
SONIOX_STT_MAX_ENDPOINT_DELAY_MS=800
# v5 endpointing sensitivity (optional). Higher = finalize sooner (snappier turn-taking),
# lower = wait longer (fewer mid-sentence cutoffs). Leave empty to use the model default.
SONIOX_STT_ENDPOINT_SENSITIVITY=
SONIOX_STT_ENDPOINT_WAIT_S=0.4
SONIOX_STT_FINALIZE_TIMEOUT_S=1.0
SONIOX_STT_REALTIME_FINALIZE_TIMEOUT_S=1.0
SONIOX_STT_MIN_TOKEN_CONFIDENCE=0.35
SONIOX_STT_PRECONNECT=true
SONIOX_STT_KEEPALIVE_INTERVAL_S=5.0
SONIOX_STT_CONTEXT_MAX_CHARS=10000

# --- Gemini LLM ---
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1400

# --- RAG ---
RAG_VECTOR_BACKEND=faiss
QDRANT_MODE=server
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aifc_chunks
QDRANT_VECTOR_SIZE=1024
RAG_ANN_TOP_K=20
RAG_FINAL_TOP_K=5
RAG_MIN_ANN_SCORE=0.50
EMBEDDING_BATCH_SIZE=64
INGEST_BATCH_SIZE=64
LOCAL_RAG_STARTUP_PREWARM=true
LOCAL_RAG_PREWARM_QUERY='What is the AIFC FinTech Lab?'

# --- Answer race and cache ---
ANSWER_RACE_ENABLED=true
ANSWER_RACE_TIMEOUT_MS=250
GEMINI_RAG_MAX_WAIT_MS=12000
PARTIAL_WIN_GRACE_MS=350
FAQ_WIN_THRESHOLD=0.90
CACHE_WIN_THRESHOLD=0.90
LOCAL_RAG_HIGH_THRESHOLD=0.65
LOCAL_RAG_PARTIAL_THRESHOLD=0.45
CACHE_HIGH_CONFIDENCE_ONLY=true
AIFC_FALLBACK_EMAIL=info@aifc.kz

# --- External RAG ---
EXTERNAL_RAG_ENABLED=true
EXTERNAL_RAG_URL=https://aifc-aia.vercel.app/api/integrations/rag/search
EXTERNAL_RAG_AUTH_HEADER=x-api-key
EXTERNAL_RAG_TIMEOUT_S=8.0
EXTERNAL_RAG_HYBRID=true
EXTERNAL_RAG_WITH_RERANK=true
EXTERNAL_RAG_LIMIT=30
EXTERNAL_RAG_TOP_N=3
EXTERNAL_RAG_HIGH_THRESHOLD=0.25
EXTERNAL_RAG_PARTIAL_THRESHOLD=0.10

# --- TTS ---
TTS_PROVIDER=soniox
LOCAL_TTS_URL=http://127.0.0.1:8002/tts
LOCAL_TTS_STARTUP_PREWARM=false
SONIOX_TTS_MODEL=tts-rt-v1
SONIOX_TTS_VOICE=Maya
SONIOX_TTS_AUDIO_FORMAT=pcm_s16le
SONIOX_TTS_SAMPLE_RATE=24000
SONIOX_TTS_STREAMING_AVATAR=true
SONIOX_TTS_KEEPALIVE_INTERVAL_S=10
TTS_PREWARM_QUERY_WAIT_S=2.5
SONIOX_TTS_CONNECT_TIMEOUT_S=20
SONIOX_TTS_PRECONNECT_TIMEOUT_S=2.5
SONIOX_TTS_STREAM_TIMEOUT_S=30
SONIOX_TTS_FORCE_IPV4=true
ELEVEN_TTS_VOICE_ID=3vbrfmIQGJrswxh7ife4
ELEVEN_TTS_MODEL=eleven_flash_v2_5
ELEVEN_TTS_MODEL_KK=eleven_v3
ELEVEN_TTS_OUTPUT_FORMAT=pcm_22050
ELEVEN_TTS_STABILITY=0.45
ELEVEN_TTS_SIMILARITY_BOOST=0.85
ELEVEN_TTS_STYLE=0.0
ELEVEN_TTS_USE_SPEAKER_BOOST=true
FIRST_TTS_CHARS=48
MIN_TTS_CHARS=80
MAX_TTS_CHARS=220
SHORT_SENTENCE_CHARS=40

# --- SyncTalk avatar ---
SYNCTALK_AVATAR=aifc-avatar-5-3min_exp_6
SYNCTALK_HTTP_PORT=8005
SYNCTALK_STREAM_URL=http://127.0.0.1:8005/infer_stream
SYNCTALK_TIMEOUT_S=120.0
# Per-frame stall timeout inside a streaming segment. Normal frames arrive in ~20-40ms;
# an occasional GPU-contention stall used to block the WHOLE 8s default → a visible
# ~8s chunk-transition gap. 3s fails the stalled segment fast (frontend moves on / the
# 1-retry in response_stream may recover) while staying well above the normal frame time.
SYNCTALK_FRAME_TIMEOUT_S=3.0
SYNCTALK_BATCH_SIZE=32
SYNCTALK_MAX_FRAMES=64
SYNCTALK_MAX_WAIT_S=0.015
SYNCTALK_CPU_WORKERS=4
SYNCTALK_GPU_WORKERS=4

# --- Single-pipeline session guard ---
# One SyncTalk GPU pipeline → admit one live session at a time so concurrent users
# don't contend for it (which reintroduces frame stutter). Extra connections get a
# "busy" overlay and auto-retry. Raise only if you add GPU/pipeline capacity.
# An admitted-but-idle session is evicted after SESSION_IDLE_EVICT_S so the slot
# never locks forever (heartbeat pings do NOT count as activity).
MAX_CONCURRENT_SESSIONS=1
SESSION_IDLE_EVICT_S=120

# --- Avatar TTS segmentation ---
# PCM is sub-segmented into SyncTalk as TTS streams (response_stream.py). The first
# segment is kept ~1s (not tiny) so chunk 0 isn't a choppy 4-frame micro-clip that
# stutters and instantly transitions; later segments are ~2.5s to limit per-call
# overhead. MIN_SEGMENT_MS is the floor used only for tail-padding.
AVATAR_TTS_FIRST_SEGMENT_MS=1000
AVATAR_TTS_MIN_SEGMENT_MS=220
AVATAR_TTS_SEGMENT_MS=1500
AVATAR_TTS_MAX_SEGMENT_MS=3000
