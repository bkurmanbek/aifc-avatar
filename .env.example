# Copy this to .env and fill in real values.
# See config.env for all tunable defaults — only put overrides and secrets here.

# --- Machine paths ---
AIFC_DATA_DIR=/home/youruser/data
DATA_DIR=/home/youruser/data
MODELS_DIR=/home/youruser/models
EMBEDDING_MODEL_PATH=/home/youruser/models/bge-m3
RERANKER_MODEL_PATH=/home/youruser/models/bge-reranker-v2-m3
WS_BACKEND_PYTHON=/home/youruser/miniforge3/bin/python
SYNCTALK_PYTHON=/home/youruser/miniforge3/envs/synctalk2d/bin/python
SYNCTALK_DIR=/home/youruser/SyncTalk_2D
FAISS_INDEX_PATH=/home/youruser/data/faiss/aifc_chunks.index
FAISS_METADATA_PATH=/home/youruser/data/faiss/aifc_chunks.metadata.json
QDRANT_PATH=/home/youruser/data/vector_db
RAG_CHUNKS_PATH=/home/youruser/data/chunks/chunks.json

# --- Secrets ---
GOOGLE_API_KEY=
GEMINI_API_KEY=
SONIOX_API_KEY=
ELEVEN_API_KEY=
EXTERNAL_RAG_API_KEY=
