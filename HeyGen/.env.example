# LiveAvatar LITE mode (modular) + Google Sulafat TTS. Copy to .env; never commit real keys.
# All keys are used ONLY server-side (api/session.ts, api/tts.ts); none reach the browser.

# LiveAvatar (https://app.liveavatar.com → API key)
LIVEAVATAR_API_KEY=
# A LiveAvatar-ENABLED avatar id (dashboard or GET /v1/avatars). Your custom avatar
# 5370f4fc3bef4fe7bb2934be58cf718e must first be imported/enabled in LiveAvatar.
LIVEAVATAR_AVATAR_ID=5370f4fc3bef4fe7bb2934be58cf718e
# Set to 1 to ignore the avatar id and use HeyGen's free sandbox avatar (no credits, ~1-min).
LIVEAVATAR_SANDBOX=
# Optional override of the API base.
LIVEAVATAR_API_BASE=https://api.liveavatar.com

# Google Gemini TTS (the Sulafat voice that feeds agent.speak)
GEMINI_API_KEY=
GEMINI_TTS_VOICE=Sulafat
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
